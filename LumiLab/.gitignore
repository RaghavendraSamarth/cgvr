# ==============================================================================
# Unity .gitignore — Comprehensive Rule Set
# ==============================================================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Asset Store cache & temporary data
/AssetStore-5.x/

# Unity lockfiles
Temp/UnityLockfile
*.lock

# Autogenerated Visual Studio / VS Code / Rider project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler & crash logs
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.stackdump

# IDE and Editor directories
.vs/
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Node / Web artifacts (if any local toolchains are run)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/

# Unity Default Template Scenes & Sample Assets (not used by LumiLab)
Assets/Scenes/Cockpit/
Assets/Scenes/Cockpit.meta
Assets/Scenes/Garden/
Assets/Scenes/Garden.meta
Assets/Scenes/Oasis/
Assets/Scenes/Oasis.meta
Assets/Scenes/Terminal/
Assets/Scenes/Terminal.meta
Assets/Tutorials/
Assets/Tutorials.meta
Assets/SharedAssets/
Assets/SharedAssets.meta

# LumiLab specific build logs & scratch directories
build_player.log
build_webgl.log
unity_compile_check.log
build_showroom.log

